# ==============================================================================
# FASTAPI AI MICROSERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to apps/ai-service/.env or pass these environment variables to the container.
# NEVER commit real Gemini API keys or service secrets to version control.

# ------------------------------------------------------------------------------
# 1. RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
AI_SERVICE_ENV=production
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. INTERNAL SECURITY (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Must match INTERNAL_SERVICE_SECRET in the NestJS API environment
INTERNAL_SERVICE_SECRET=replace_with_internal_microservice_shared_secret
MAIN_API_INTERNAL_URL=http://api:4000/api/v1

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Production Gemini API key obtained from Google AI Studio / Google Cloud Vertex AI
GEMINI_API_KEY=replace_with_valid_gemini_api_key

# Primary LLM model identifier
GEMINI_MODEL=gemini-3.8-flash

# Per-request timeout in seconds
GEMINI_REQUEST_TIMEOUT=30

# Maximum exponential backoff retries for rate limits
GEMINI_MAX_RETRIES=3

# Set to false in production to ensure authentic AI responses, or true for offline testing fallback
AI_MOCK_FALLBACK=false
