# ==============================================================================
# NEXT.JS FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development, or configure in your production runtime / container.
# All variables prefixed with NEXT_PUBLIC_ are embedded into the client bundle at build time.
# NEVER put secret keys or database credentials in this file.

# Application Display Name
NEXT_PUBLIC_APP_NAME="Samahat Taibah Educational Management System"

# Backend REST & WebSocket API Base URL
# In development: http://localhost:4000/api/v1
# In production: https://ems.yourdomain.com/api/v1 (or /api/v1 behind reverse proxy)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Direct or Proxy URL for AI Service (used by Copilot interfaces)
# In development: http://localhost:8000
# In production: https://ems.yourdomain.com/ai (or internal via backend API)
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# Next.js Server Port (Default: 3000)
PORT=3000

# Node Environment
NODE_ENV=production
