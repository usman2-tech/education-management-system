# ==============================================================================
# NESTJS BACKEND API ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to apps/api/.env or pass these environment variables to the container.
# In production, ensure all secrets are generated using high-entropy random keys (e.g. openssl rand -base64 32).
# NEVER commit actual production secrets to version control.

# ------------------------------------------------------------------------------
# 1. RUNTIME & SERVER
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
# Comma-separated list of allowed origins. Use exact domain in production.
CORS_ORIGIN=https://ems.yourdomain.com,http://localhost:3000
# Set to true only if API documentation should be publicly accessible
SWAGGER_ENABLED=false
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_strong_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=1h
# Generate with: openssl rand -base64 32
JWT_REFRESH_SECRET=replace_with_strong_random_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Shared internal token for secure backend <-> AI microservice communication
INTERNAL_SERVICE_SECRET=replace_with_internal_microservice_shared_secret

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Standard PostgreSQL connection string. Format: postgresql://[user]:[password]@[host]:[port]/[db]?schema=public
DATABASE_URL=postgresql://ems_user:replace_with_secure_db_password@postgres:5432/ems_database?schema=public

# ------------------------------------------------------------------------------
# 4. REDIS CACHE, SOCKET.IO ADAPTER & TASK QUEUES
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. INTER-SERVICE CONNECTIVITY
# ------------------------------------------------------------------------------
# Internal URL of the Python FastAPI AI microservice
AI_SERVICE_URL=http://ai-service:8000

# ------------------------------------------------------------------------------
# 6. PERSISTENT FILE STORAGE
# ------------------------------------------------------------------------------
# Directory inside container or server where uploaded documents and photos reside
UPLOAD_DIR=/app/apps/api/uploads
MAX_FILE_SIZE_BYTES=10485760
