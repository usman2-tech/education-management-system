// ==============================================================================
// PRISMA SCHEMA - EDUCATIONAL MANAGEMENT SYSTEM (EMS)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Foundational System Health & Audit Model (Used in Task 001 verification)
// ------------------------------------------------------------------------------
model SystemHealthCheck {
  id        String   @id @default(uuid())
  service   String
  status    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("system_health_checks")
}

// ------------------------------------------------------------------------------
// Enums for Role-Based Access Control and Institutional Tenancy (Task 002 Ready)
// ------------------------------------------------------------------------------
enum UserRole {
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum SchoolStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  INACTIVE
}

enum TeacherEmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum GuardianRelationshipType {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  STEP_PARENT
  OTHER
}

enum RelationshipVerificationStatus {
  VERIFIED
  PENDING_VERIFICATION
  REVOKED
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  TRANSFERRED
  COMPLETED
}

// ------------------------------------------------------------------------------
// Core Multi-Tenant Institutional Models
// ------------------------------------------------------------------------------
model School {
  id               String             @id @default(uuid())
  name             String
  code             String             @unique
  domain           String?
  status           SchoolStatus       @default(ACTIVE)
  address          String?
  city             String?
  state            String?
  country          String?            @default("USA")
  logoUrl          String?
  phone            String?
  email            String?
  settings         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  users            User[]
  memberships      SchoolMembership[]
  academicYears    AcademicYear[]
  classes          SchoolClass[]
  subjects         Subject[]
  timetableEntries TimetableEntry[]

  @@map("schools")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  actorId    String?
  actorEmail String?
  schoolId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model User {
  id                        String                        @id @default(uuid())
  email                     String                        @unique
  passwordHash              String
  firstName                 String
  lastName                  String
  role                      UserRole
  schoolId                  String?
  school                    School?                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  isActive                  Boolean                       @default(true)
  avatarUrl                 String?
  phone                     String?
  lastLoginAt               DateTime?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt

  refreshTokens             RefreshToken[]
  teacherProfile            TeacherProfile?
  studentProfile            StudentProfile?
  parentProfile             ParentGuardianProfile?
  memberships               SchoolMembership[]

  // Guardian <-> Student Relationships
  guardianRelationships     StudentGuardianRelationship[] @relation("GuardianUser")
  studentRelationships      StudentGuardianRelationship[] @relation("StudentUser")

  // Academic Structures & Schedules
  classTeacherSections      ClassSection[]                @relation("ClassTeacher")
  teacherSubjectAssignments TeacherSubjectAssignment[]
  classEnrollments          ClassEnrollment[]
  timetableEntries          TimetableEntry[]

  @@index([schoolId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model TeacherProfile {
  id               String                  @id @default(uuid())
  userId           String                  @unique
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String?
  qualification    String?
  specialization   String?
  joiningDate      DateTime                @default(now())
  employmentStatus TeacherEmploymentStatus @default(ACTIVE)
  phone            String?
  address          String?
  bio              String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([employeeCode])
  @@map("teacher_profiles")
}

model StudentProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNumber  String?
  gradeLevel       String?
  dateOfBirth      DateTime?
  gender           String?
  bloodGroup       String?
  emergencyContact String?
  address          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([admissionNumber])
  @@map("student_profiles")
}

model ParentGuardianProfile {
  id                   String    @id @default(uuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation           String?
  employer             String?
  relationshipToFamily String?
  phoneAlt             String?
  address              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("parent_guardian_profiles")
}

model StudentGuardianRelationship {
  id                 String                         @id @default(uuid())
  guardianId         String
  guardian           User                           @relation("GuardianUser", fields: [guardianId], references: [id], onDelete: Cascade)
  studentId          String
  student            User                           @relation("StudentUser", fields: [studentId], references: [id], onDelete: Cascade)
  relationshipType   GuardianRelationshipType       @default(MOTHER)
  verificationStatus RelationshipVerificationStatus @default(VERIFIED)
  isPrimaryContact   Boolean                        @default(false)
  isEmergencyContact Boolean                        @default(true)
  notes              String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@unique([guardianId, studentId])
  @@index([guardianId])
  @@index([studentId])
  @@map("student_guardian_relationships")
}

model AcademicYear {
  id                        String                     @id @default(uuid())
  schoolId                  String
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                      String
  startDate                 DateTime
  endDate                   DateTime
  isCurrent                 Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  sections                  ClassSection[]
  enrollments               ClassEnrollment[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  timetableEntries          TimetableEntry[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

model SchoolClass {
  id          String         @id @default(uuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sections    ClassSection[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("school_classes")
}

model ClassSection {
  id                        String                     @id @default(uuid())
  classId                   String
  schoolClass               SchoolClass                @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId            String
  academicYear              AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name                      String
  capacity                  Int                        @default(30)
  roomNumber                String?
  classTeacherId            String?
  classTeacher              User?                      @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  enrollments               ClassEnrollment[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  timetableEntries          TimetableEntry[]

  @@unique([classId, academicYearId, name])
  @@index([classId])
  @@index([academicYearId])
  @@map("class_sections")
}

model Subject {
  id                        String                     @id @default(uuid())
  schoolId                  String
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                      String
  code                      String
  department                String?
  credits                   Float                      @default(1.0)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  teacherSubjectAssignments TeacherSubjectAssignment[]
  timetableEntries          TimetableEntry[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

model ClassEnrollment {
  id             String           @id @default(uuid())
  studentId      String
  student        User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId      String
  section        ClassSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  rollNumber     String?
  enrolledAt     DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([studentId, academicYearId])
  @@index([sectionId])
  @@index([studentId])
  @@map("class_enrollments")
}

model TeacherSubjectAssignment {
  id             String       @id @default(uuid())
  teacherId      String
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sectionId      String
  section        ClassSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([teacherId, subjectId, sectionId, academicYearId])
  @@index([teacherId])
  @@index([sectionId])
  @@map("teacher_subject_assignments")
}

model TimetableEntry {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sectionId      String
  section        ClassSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  dayOfWeek      Int          // 1 = Monday, 2 = Tuesday, ... 7 = Sunday
  periodName     String       // e.g. "Period 1"
  startTime      String       // e.g. "08:30"
  endTime        String       // e.g. "09:20"
  roomNumber     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([schoolId])
  @@index([sectionId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([roomNumber, dayOfWeek])
  @@map("timetable_entries")
}

model SchoolMembership {
  id               String                   @id @default(uuid())
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId         String
  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role             UserRole
  isActive         Boolean                  @default(true)
  employeeCode     String?
  employmentStatus TeacherEmploymentStatus? @default(ACTIVE)
  joinedAt         DateTime                 @default(now())
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@index([userId])
  @@map("school_memberships")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}



