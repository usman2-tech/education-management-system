// ==============================================================================
// PRISMA SCHEMA - EDUCATIONAL MANAGEMENT SYSTEM (EMS)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Foundational System Health & Audit Model (Used in Task 001 verification)
// ------------------------------------------------------------------------------
model SystemHealthCheck {
  id        String   @id @default(uuid())
  service   String
  status    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("system_health_checks")
}

// ------------------------------------------------------------------------------
// Enums for Role-Based Access Control and Institutional Tenancy (Task 002 Ready)
// ------------------------------------------------------------------------------
enum UserRole {
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum SchoolStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  INACTIVE
}

enum TeacherEmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum GuardianRelationshipType {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  STEP_PARENT
  OTHER
}

enum RelationshipVerificationStatus {
  VERIFIED
  PENDING_VERIFICATION
  REVOKED
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  TRANSFERRED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSessionType {
  DAILY
  PERIOD
}

enum AttendanceSessionStatus {
  DRAFT
  FINALIZED
}

enum NFCIdentityStatus {
  ACTIVE
  DISABLED
}

enum NFCEventStatus {
  ACCEPTED
  REJECTED
  DUPLICATE
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum HomeworkSubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
  RESUBMISSION_REQUESTED
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  RESULTS_PUBLISHED
}

enum ExamQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  HOMEWORK
  EXAM
  GRADE
  ATTENDANCE
  SUBSCRIPTION
  ANNOUNCEMENT
  FEE
}

// ------------------------------------------------------------------------------
// Core Multi-Tenant Institutional Models
// ------------------------------------------------------------------------------
model School {
  id               String             @id @default(uuid())
  name             String
  code             String             @unique
  domain           String?
  status           SchoolStatus       @default(ACTIVE)
  address          String?
  city             String?
  state            String?
  country          String?            @default("USA")
  logoUrl          String?
  phone            String?
  email            String?
  settings         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  users               User[]
  memberships         SchoolMembership[]
  academicYears       AcademicYear[]
  classes             SchoolClass[]
  subjects            Subject[]
  timetableEntries    TimetableEntry[]
  attendanceSessions  AttendanceSession[]
  nfcIdentities       NFCIdentity[]
  nfcAttendanceEvents NFCAttendanceEvent[]
  assessmentCategories AssessmentCategory[]
  assessments         Assessment[]
  gradingScales       GradingScale[]
  homeworks           Homework[]
  courses             Course[]
  exams               Exam[]
  subscriptions       SchoolSubscription[]
  subscriptionCodes   SubscriptionCode[]
  codeRedemptions     CodeRedemption[]
  notifications       Notification[]
  conversations       Conversation[]
  invitations         UserInvitation[]

  // Fee Management (TASK 021)
  feeCategories       FeeCategory[]
  feeStructures       FeeStructure[]
  feeDiscounts        FeeDiscount[]
  studentFeeAssignments StudentFeeAssignment[]
  feeInvoices         FeeInvoice[]
  feePayments         FeePayment[]

  // AI Assistant (TASK 022)
  aiConversations     AIConversation[]
  aiUsageRecords      AIUsageRecord[]

  @@map("schools")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  actorId    String?
  actorEmail String?
  schoolId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model User {
  id                        String                        @id @default(uuid())
  email                     String                        @unique
  passwordHash              String
  firstName                 String
  lastName                  String
  role                      UserRole
  schoolId                  String?
  school                    School?                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  isActive                  Boolean                       @default(true)
  avatarUrl                 String?
  phone                     String?
  lastLoginAt               DateTime?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt

  refreshTokens             RefreshToken[]
  passwordResetTokens       PasswordResetToken[]
  sentInvitations           UserInvitation[]              @relation("InvitedByUser")
  teacherProfile            TeacherProfile?
  studentProfile            StudentProfile?
  parentProfile             ParentGuardianProfile?
  memberships               SchoolMembership[]

  // Guardian <-> Student Relationships
  guardianRelationships     StudentGuardianRelationship[] @relation("GuardianUser")
  studentRelationships      StudentGuardianRelationship[] @relation("StudentUser")

  // Academic Structures & Schedules
  classTeacherSections      ClassSection[]                @relation("ClassTeacher")
  teacherSubjectAssignments TeacherSubjectAssignment[]
  classEnrollments          ClassEnrollment[]
  timetableEntries          TimetableEntry[]

  // Attendance Management & NFC Simulation
  createdAttendanceSessions   AttendanceSession[]  @relation("AttendanceCreator")
  finalizedAttendanceSessions AttendanceSession[]  @relation("AttendanceFinalizer")
  studentAttendanceRecords    AttendanceRecord[]   @relation("AttendanceStudent")
  markedAttendanceRecords     AttendanceRecord[]   @relation("AttendanceMarker")
  studentNfcIdentity          NFCIdentity?         @relation("StudentNFC")
  nfcAttendanceEvents         NFCAttendanceEvent[] @relation("NFCEventStudent")

  // Grades & Academic Performance (TASK 009)
  createdAssessments          Assessment[]         @relation("AssessmentCreator")
  studentGrades               StudentGrade[]       @relation("GradeStudent")
  markedGrades                StudentGrade[]       @relation("GradeMarker")

  // Homework & Content (TASK 010)
  createdHomeworks            Homework[]             @relation("HomeworkTeacher")
  homeworkSubmissions         HomeworkSubmission[]   @relation("SubmissionStudent")
  gradedHomeworkSubmissions   HomeworkSubmission[]   @relation("SubmissionGrader")

  // Courses (TASK 011)
  createdCourses              Course[]               @relation("CourseCreator")
  courseEnrollments           CourseEnrollment[]     @relation("CourseStudent")
  lessonProgress              LessonProgress[]       @relation("LessonStudent")

  // Exams (TASK 012)
  createdExams                Exam[]                 @relation("ExamCreator")
  examAttempts                ExamAttempt[]          @relation("ExamStudent")
  gradedExamAttempts          ExamAttempt[]          @relation("ExamGrader")

  // Subscriptions & Codes (TASKS 013 & 014)
  createdSubscriptionCodes    SubscriptionCode[]     @relation("CodeCreator")
  codeRedemptions             CodeRedemption[]       @relation("CodeRedeemer")

  // Notifications & Messaging (TASK 015)
  notifications               Notification[]         @relation("NotificationUser")
  conversationParticipants    ConversationParticipant[] @relation("ConversationUser")
  sentDirectMessages          DirectMessage[]        @relation("MessageSender")

  // Fee Management (TASK 021)
  studentFeeAssignments       StudentFeeAssignment[] @relation("StudentFeeAssignments")
  studentFeeInvoices          FeeInvoice[]           @relation("StudentFeeInvoices")
  studentFeePayments          FeePayment[]           @relation("StudentFeePayments")
  recordedFeePayments         FeePayment[]           @relation("RecordedFeePayments")

  // AI Assistant (TASK 022)
  aiConversations             AIConversation[]       @relation("UserAIConversations")
  aiUsageRecords              AIUsageRecord[]        @relation("UserAIUsage")

  @@index([schoolId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model TeacherProfile {
  id               String                  @id @default(uuid())
  userId           String                  @unique
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String?
  qualification    String?
  specialization   String?
  joiningDate      DateTime                @default(now())
  employmentStatus TeacherEmploymentStatus @default(ACTIVE)
  phone            String?
  address          String?
  bio              String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([employeeCode])
  @@map("teacher_profiles")
}

model StudentProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNumber  String?
  gradeLevel       String?
  dateOfBirth      DateTime?
  gender           String?
  bloodGroup       String?
  emergencyContact String?
  address          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([admissionNumber])
  @@map("student_profiles")
}

model ParentGuardianProfile {
  id                   String    @id @default(uuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation           String?
  employer             String?
  relationshipToFamily String?
  phoneAlt             String?
  address              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("parent_guardian_profiles")
}

model StudentGuardianRelationship {
  id                 String                         @id @default(uuid())
  guardianId         String
  guardian           User                           @relation("GuardianUser", fields: [guardianId], references: [id], onDelete: Cascade)
  studentId          String
  student            User                           @relation("StudentUser", fields: [studentId], references: [id], onDelete: Cascade)
  relationshipType   GuardianRelationshipType       @default(MOTHER)
  verificationStatus RelationshipVerificationStatus @default(VERIFIED)
  isPrimaryContact   Boolean                        @default(false)
  isEmergencyContact Boolean                        @default(true)
  notes              String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@unique([guardianId, studentId])
  @@index([guardianId])
  @@index([studentId])
  @@map("student_guardian_relationships")
}

model AcademicYear {
  id                        String                     @id @default(uuid())
  schoolId                  String
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                      String
  startDate                 DateTime
  endDate                   DateTime
  isCurrent                 Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  sections                  ClassSection[]
  enrollments               ClassEnrollment[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  timetableEntries          TimetableEntry[]
  attendanceSessions        AttendanceSession[]
  assessmentCategories      AssessmentCategory[]
  assessments               Assessment[]
  homeworks                 Homework[]
  exams                     Exam[]

  // Fee Management (TASK 021)
  feeStructures             FeeStructure[]
  studentFeeAssignments     StudentFeeAssignment[]
  feeInvoices               FeeInvoice[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

model SchoolClass {
  id          String         @id @default(uuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sections    ClassSection[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("school_classes")
}

model ClassSection {
  id                        String                     @id @default(uuid())
  classId                   String
  schoolClass               SchoolClass                @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId            String
  academicYear              AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name                      String
  capacity                  Int                        @default(30)
  roomNumber                String?
  classTeacherId            String?
  classTeacher              User?                      @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  enrollments               ClassEnrollment[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  timetableEntries          TimetableEntry[]
  attendanceSessions        AttendanceSession[]
  assessments               Assessment[]
  homeworks                 Homework[]
  exams                     Exam[]

  @@unique([classId, academicYearId, name])
  @@index([classId])
  @@index([academicYearId])
  @@map("class_sections")
}

model Subject {
  id                        String                     @id @default(uuid())
  schoolId                  String
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                      String
  code                      String
  department                String?
  credits                   Float                      @default(1.0)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  teacherSubjectAssignments TeacherSubjectAssignment[]
  timetableEntries          TimetableEntry[]
  assessmentCategories      AssessmentCategory[]
  assessments               Assessment[]
  homeworks                 Homework[]
  courses                   Course[]
  exams                     Exam[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

model ClassEnrollment {
  id             String           @id @default(uuid())
  studentId      String
  student        User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId      String
  section        ClassSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  rollNumber     String?
  enrolledAt     DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([studentId, academicYearId])
  @@index([sectionId])
  @@index([studentId])
  @@map("class_enrollments")
}

model TeacherSubjectAssignment {
  id             String       @id @default(uuid())
  teacherId      String
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sectionId      String
  section        ClassSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([teacherId, subjectId, sectionId, academicYearId])
  @@index([teacherId])
  @@index([sectionId])
  @@map("teacher_subject_assignments")
}

model TimetableEntry {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sectionId      String
  section        ClassSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  dayOfWeek      Int          // 1 = Monday, 2 = Tuesday, ... 7 = Sunday
  periodName     String       // e.g. "Period 1"
  startTime      String       // e.g. "08:30"
  endTime        String       // e.g. "09:20"
  roomNumber     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  attendanceSessions AttendanceSession[]

  @@index([schoolId])
  @@index([sectionId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([roomNumber, dayOfWeek])
  @@map("timetable_entries")
}

model SchoolMembership {
  id               String                   @id @default(uuid())
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId         String
  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role             UserRole
  isActive         Boolean                  @default(true)
  employeeCode     String?
  employmentStatus TeacherEmploymentStatus? @default(ACTIVE)
  joinedAt         DateTime                 @default(now())
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@index([userId])
  @@map("school_memberships")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model UserInvitation {
  id          String    @id @default(uuid())
  email       String
  role        UserRole
  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  accepted    Boolean   @default(false)
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User      @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([schoolId])
  @@index([tokenHash])
  @@map("user_invitations")
}

// ------------------------------------------------------------------------------
// Attendance Management & NFC Simulation Models (TASK 008)
// ------------------------------------------------------------------------------
model AttendanceSession {
  id               String                  @id @default(uuid())
  schoolId         String
  school           School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId   String
  academicYear     AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classSectionId   String
  classSection     ClassSection            @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  attendanceDate   DateTime
  sessionType      AttendanceSessionType   @default(DAILY)
  timetableEntryId String?
  timetableEntry   TimetableEntry?         @relation(fields: [timetableEntryId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User                    @relation("AttendanceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  status           AttendanceSessionStatus @default(DRAFT)
  finalizedAt      DateTime?
  finalizedById    String?
  finalizedBy      User?                   @relation("AttendanceFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  records          AttendanceRecord[]
  nfcEvents        NFCAttendanceEvent[]

  @@index([schoolId])
  @@index([classSectionId, attendanceDate])
  @@index([attendanceDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String            @id @default(uuid())
  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           String
  student             User              @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status              AttendanceStatus  @default(PRESENT)
  remarks             String?
  markedById          String
  markedBy            User              @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Cascade)
  markedAt            DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
  @@index([attendanceSessionId])
  @@map("attendance_records")
}

model NFCIdentity {
  id                     String            @id @default(uuid())
  schoolId               String
  school                 School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId              String            @unique
  student                User              @relation("StudentNFC", fields: [studentId], references: [id], onDelete: Cascade)
  simulatedCardTokenHash String            @unique
  status                 NFCIdentityStatus @default(ACTIVE)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([schoolId])
  @@index([simulatedCardTokenHash])
  @@map("nfc_identities")
}

model NFCAttendanceEvent {
  id                  String            @id @default(uuid())
  schoolId            String
  school              School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           String?
  student             User?             @relation("NFCEventStudent", fields: [studentId], references: [id], onDelete: SetNull)
  eventType           String            @default("SIMULATED_SCAN")
  eventStatus         NFCEventStatus    @default(ACCEPTED)
  rejectionReason     String?
  createdAt           DateTime          @default(now())

  @@index([schoolId])
  @@index([attendanceSessionId])
  @@index([studentId])
  @@map("nfc_attendance_events")
}

// ------------------------------------------------------------------------------
// Grades & Academic Performance Models (TASK 009)
// ------------------------------------------------------------------------------
model AssessmentCategory {
  id               String        @id @default(uuid())
  schoolId         String
  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId   String?
  academicYear     AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  subjectId        String?
  subject          Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  name             String        // Quiz, Assignment, Class Test, Project, Midterm, Final Exam
  description      String?
  weightPercentage Float         // e.g. 20.0 for 20%
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  assessments      Assessment[]

  @@index([schoolId])
  @@index([academicYearId])
  @@index([subjectId])
  @@map("assessment_categories")
}

model Assessment {
  id             String             @id @default(uuid())
  schoolId       String
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classSectionId String
  classSection   ClassSection       @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  categoryId     String
  category       AssessmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  maximumMarks   Float              // > 0
  assessmentDate String             // YYYY-MM-DD
  createdById    String
  createdBy      User               @relation("AssessmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  status         AssessmentStatus   @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  grades         StudentGrade[]

  @@index([schoolId])
  @@index([classSectionId, subjectId])
  @@index([academicYearId])
  @@index([categoryId])
  @@map("assessments")
}

model StudentGrade {
  id            String     @id @default(uuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User       @relation("GradeStudent", fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained Float?     // Nullable to clearly distinguish missing grade from zero marks
  feedback      String?
  gradedById    String
  gradedBy      User       @relation("GradeMarker", fields: [gradedById], references: [id], onDelete: Cascade)
  gradedAt      DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId])
  @@map("student_grades")
}

model GradingScale {
  id                String   @id @default(uuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String   // e.g. "Standard Scale", "Honors Scale"
  minimumPercentage Float    // e.g. 90.0
  maximumPercentage Float    // e.g. 100.0
  letterGrade       String   // e.g. "A+", "A", "B", "C", "D", "F"
  gradePoint        Float?   // e.g. 4.0
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([schoolId])
  @@index([minimumPercentage, maximumPercentage])
  @@map("grading_scales")
}

// ------------------------------------------------------------------------------
// Homework & Learning Content Models (TASK 010)
// ------------------------------------------------------------------------------
model Homework {
  id             String           @id @default(uuid())
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear   AcademicYear?    @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  classSectionId String
  classSection   ClassSection     @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        User             @relation("HomeworkTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  title          String
  instructions   String           @db.Text
  dueDate        DateTime
  maxPoints      Float            @default(100.0)
  status         HomeworkStatus   @default(DRAFT)
  attachments    String?          // JSON string or URL
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  submissions    HomeworkSubmission[]

  @@index([schoolId])
  @@index([classSectionId, subjectId])
  @@index([teacherId])
  @@index([dueDate])
  @@map("homeworks")
}

model HomeworkSubmission {
  id           String                   @id @default(uuid())
  homeworkId   String
  homework     Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId    String
  student      User                     @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  content      String?                  @db.Text
  attachments  String?                  // JSON string or URL
  status       HomeworkSubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime                 @default(now())
  isLate       Boolean                  @default(false)
  grade        Float?
  feedback     String?                  @db.Text
  gradedById   String?
  gradedBy     User?                    @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt     DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@index([homeworkId])
  @@map("homework_submissions")
}

// ------------------------------------------------------------------------------
// Course Management Models (TASK 011)
// ------------------------------------------------------------------------------
model Course {
  id           String             @id @default(uuid())
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title        String
  code         String
  description  String?            @db.Text
  thumbnailUrl String?
  published    Boolean            @default(false)
  createdById  String
  createdBy    User               @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  modules      CourseModule[]
  enrollments  CourseEnrollment[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([subjectId])
  @@map("courses")
}

model CourseModule {
  id          String         @id @default(uuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?        @db.Text
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lessons     CourseLesson[]

  @@index([courseId])
  @@map("course_modules")
}

model CourseLesson {
  id              String           @id @default(uuid())
  moduleId        String
  module          CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  content         String           @db.Text
  videoUrl        String?
  attachments     String?
  order           Int              @default(0)
  durationMinutes Int              @default(30)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  progress        LessonProgress[]

  @@index([moduleId])
  @@map("course_lessons")
}

model CourseEnrollment {
  id          String           @id @default(uuid())
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId   String
  student     User             @relation("CourseStudent", fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime         @default(now())
  status      EnrollmentStatus @default(ACTIVE)
  completedAt DateTime?

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([courseId])
  @@map("course_enrollments")
}

model LessonProgress {
  id          String       @id @default(uuid())
  lessonId    String
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId   String
  student     User         @relation("LessonStudent", fields: [studentId], references: [id], onDelete: Cascade)
  isCompleted Boolean      @default(true)
  completedAt DateTime     @default(now())

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ------------------------------------------------------------------------------
// Exam Management Models (TASK 012)
// ------------------------------------------------------------------------------
model Exam {
  id              String         @id @default(uuid())
  schoolId        String
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId  String?
  academicYear    AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  classSectionId  String
  classSection    ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User           @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title           String
  description     String?        @db.Text
  examDate        DateTime
  startTime       String?
  endTime         String?
  durationMinutes Int            @default(60)
  totalMarks      Float
  passingMarks    Float          @default(40.0)
  status          ExamStatus     @default(DRAFT)
  assessmentId    String?        // Link to Assessment in Task 009
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  questions       ExamQuestion[]
  attempts        ExamAttempt[]

  @@index([schoolId])
  @@index([classSectionId, subjectId])
  @@index([examDate])
  @@map("exams")
}

model ExamQuestion {
  id            String               @id @default(uuid())
  examId        String
  exam          Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText  String               @db.Text
  questionType  ExamQuestionType     @default(MULTIPLE_CHOICE)
  options       String?              @db.Text // JSON string array of choices for MCQ
  correctAnswer String?              @db.Text // Answer string for auto-marking
  marks         Float                @default(5.0)
  order         Int                  @default(0)

  answers       ExamStudentAnswer[]

  @@index([examId])
  @@map("exam_questions")
}

model ExamAttempt {
  id            String              @id @default(uuid())
  examId        String
  exam          Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       User                @relation("ExamStudent", fields: [studentId], references: [id], onDelete: Cascade)
  startedAt     DateTime            @default(now())
  submittedAt   DateTime?
  status        ExamAttemptStatus   @default(IN_PROGRESS)
  obtainedMarks Float?
  percentage    Float?
  feedback      String?             @db.Text
  gradedById    String?
  gradedBy      User?               @relation("ExamGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt      DateTime?

  answers       ExamStudentAnswer[]

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([examId])
  @@map("exam_attempts")
}

model ExamStudentAnswer {
  id              String       @id @default(uuid())
  attemptId       String
  attempt         ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText      String       @db.Text
  isCorrect       Boolean?
  awardedMarks    Float?
  teacherFeedback String?      @db.Text

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("exam_student_answers")
}

// ------------------------------------------------------------------------------
// Subscription Management & Codes Models (TASKS 013 & 014)
// ------------------------------------------------------------------------------
model SubscriptionPlan {
  id           String               @id @default(uuid())
  name         String
  code         String               @unique
  description  String?              @db.Text
  price        Float                @default(0.0)
  currency     String               @default("USD")
  durationDays Int                  @default(365)
  maxStudents  Int                  @default(500)
  maxTeachers  Int                  @default(50)
  features     String?              @db.Text // JSON string of features
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  subscriptions SchoolSubscription[]
  codes         SubscriptionCode[]

  @@map("subscription_plans")
}

model SchoolSubscription {
  id        String             @id @default(uuid())
  schoolId  String
  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([schoolId])
  @@index([planId])
  @@index([status])
  @@map("school_subscriptions")
}

model SubscriptionCode {
  id             String           @id @default(uuid())
  code           String           @unique
  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  schoolId       String?
  school         School?          @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  maxRedemptions Int              @default(1)
  timesRedeemed  Int              @default(0)
  expiresAt      DateTime
  isRevoked      Boolean          @default(false)
  createdById    String
  createdBy      User             @relation("CodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  redemptions    CodeRedemption[]

  @@index([code])
  @@index([planId])
  @@index([schoolId])
  @@map("subscription_codes")
}

model CodeRedemption {
  id         String           @id @default(uuid())
  codeId     String
  code       SubscriptionCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation("CodeRedeemer", fields: [userId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  redeemedAt DateTime         @default(now())

  @@index([codeId])
  @@index([userId])
  @@index([schoolId])
  @@map("code_redemptions")
}

// ------------------------------------------------------------------------------
// Notifications & Messaging Models (TASK 015)
// ------------------------------------------------------------------------------
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([schoolId])
  @@map("notifications")
}

model Conversation {
  id            String                    @id @default(uuid())
  schoolId      String
  school        School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject       String?
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  participants  ConversationParticipant[]
  messages      DirectMessage[]

  @@index([schoolId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_participants")
}

model DirectMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("direct_messages")
}

// ==============================================================================
// Fee Management Module (TASK 021)
// ==============================================================================

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  ANNUALLY
  CUSTOM
}

enum FeeInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum FeePaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum DiscountType {
  FIXED_AMOUNT
  PERCENTAGE
  SCHOLARSHIP
  SIBLING
  WAIVER
}

model FeeCategory {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  description String?
  isTuition   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  structures  FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("fee_categories")
}

model FeeStructure {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  categoryId     String
  category       FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  gradeLevel     String?
  amount         Float
  currency       String       @default("USD")
  frequency      FeeFrequency @default(ANNUALLY)
  dueDateDays    Int          @default(30)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignments    StudentFeeAssignment[]
  invoiceItems   FeeInvoiceItem[]

  @@index([schoolId])
  @@index([academicYearId])
  @@index([categoryId])
  @@map("fee_structures")
}

model FeeDiscount {
  id          String       @id @default(uuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  type        DiscountType @default(FIXED_AMOUNT)
  value       Float
  reason      String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignments StudentFeeAssignment[]
  invoices    FeeInvoice[]

  @@index([schoolId])
  @@map("fee_discounts")
}

model StudentFeeAssignment {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        User         @relation("StudentFeeAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  discountId     String?
  discount       FeeDiscount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  customAmount   Float?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, feeStructureId, academicYearId])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@map("student_fee_assignments")
}

model FeeInvoice {
  id             String           @id @default(uuid())
  invoiceNumber  String           @unique
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        User             @relation("StudentFeeInvoices", fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  discountId     String?
  discount       FeeDiscount?     @relation(fields: [discountId], references: [id], onDelete: SetNull)
  subtotal       Float
  discountAmount Float            @default(0)
  totalAmount    Float
  paidAmount     Float            @default(0)
  balanceAmount  Float
  currency       String           @default("USD")
  status         FeeInvoiceStatus @default(UNPAID)
  issueDate      DateTime         @default(now())
  dueDate        DateTime
  voidReason     String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items          FeeInvoiceItem[]
  payments       FeePayment[]

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([status])
  @@map("fee_invoices")
}

model FeeInvoiceItem {
  id             String        @id @default(uuid())
  invoiceId      String
  invoice        FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  name           String
  amount         Float
  createdAt      DateTime      @default(now())

  @@index([invoiceId])
  @@map("fee_invoice_items")
}

model FeePayment {
  id              String           @id @default(uuid())
  receiptNumber   String           @unique
  invoiceId       String
  invoice         FeeInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId       String
  student         User             @relation("StudentFeePayments", fields: [studentId], references: [id], onDelete: Cascade)
  recordedById    String
  recordedBy      User             @relation("RecordedFeePayments", fields: [recordedById], references: [id], onDelete: Cascade)
  amount          Float
  currency        String           @default("USD")
  paymentMethod   FeePaymentMethod @default(CASH)
  paymentDate     DateTime         @default(now())
  referenceNumber String?
  notes           String?
  isReversed      Boolean          @default(false)
  reversalReason  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([schoolId])
  @@index([invoiceId])
  @@index([studentId])
  @@map("fee_payments")
}

// ------------------------------------------------------------------------------
// AI Assistant Foundation (TASK 022)
// ------------------------------------------------------------------------------

enum AIMessageSender {
  USER
  ASSISTANT
  SYSTEM
}

model AIConversation {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation("UserAIConversations", fields: [userId], references: [id], onDelete: Cascade)
  schoolId     String?
  school       School?         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title        String          @default("New Conversation")
  roleContext  UserRole
  messages     AIMessage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([schoolId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String          @id @default(uuid())
  conversationId String
  conversation   AIConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         AIMessageSender
  content        String          @db.Text
  toolCalls      Json?
  tokensUsed     Int?
  modelName      String?
  createdAt      DateTime        @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model AIUsageRecord {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("UserAIUsage", fields: [userId], references: [id], onDelete: Cascade)
  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  modelName    String
  promptTokens Int       @default(0)
  outputTokens Int       @default(0)
  totalTokens  Int       @default(0)
  toolName     String?
  success      Boolean   @default(true)
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([schoolId])
  @@index([createdAt])
  @@map("ai_usage_records")
}




