# ==============================================================================
# EDUCATIONAL MANAGEMENT SYSTEM (EMS) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or app-specific .env files before running in production or development.
# NEVER commit actual secrets, API keys, or production passwords to version control.

# ------------------------------------------------------------------------------
# 1. GENERAL / ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Educational Management System"
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# 2. MAIN BACKEND API (NestJS)
# ------------------------------------------------------------------------------
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
SWAGGER_ENABLED=true
LOG_LEVEL=debug
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d


# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ems_database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/ems_database?schema=public

# ------------------------------------------------------------------------------
# 4. CACHE & QUEUES (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. FRONTEND (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Educational Management System"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. AI SERVICE (FastAPI / Python)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_ENV=development
AI_LOG_LEVEL=info
MAIN_API_INTERNAL_URL=http://localhost:4000/api/v1
INTERNAL_SERVICE_SECRET=dev_internal_secret_key_change_in_production
