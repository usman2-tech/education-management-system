# ==============================================================================
# SAMAHAT TAIBAH INSTITUTION - EDUCATIONAL MANAGEMENT SYSTEM (EMS)
# MASTER PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Use this master file as reference or split across apps/api/.env, apps/web/.env.local,
# and apps/ai-service/.env for containerized or bare-metal deployments.
# NEVER commit production passwords, JWT keys, or API tokens to version control.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_NAME="Samahat Taibah Educational Management System"
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# 2. MAIN BACKEND API (NestJS)
# ------------------------------------------------------------------------------
PORT=4000
API_PREFIX=api/v1
# In production, specify exact institutional domain(s)
CORS_ORIGIN=https://ems.yourdomain.com,http://localhost:3000
SWAGGER_ENABLED=false
LOG_LEVEL=info

# JWT Security - Generate with `openssl rand -base64 32`
JWT_SECRET=replace_with_strong_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_strong_random_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Shared Inter-service Secret (NestJS <-> FastAPI)
INTERNAL_SERVICE_SECRET=replace_with_internal_microservice_shared_secret

# Upload Storage
UPLOAD_DIR=/app/apps/api/uploads
MAX_FILE_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL 16 with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=ems_database
DATABASE_URL=postgresql://ems_user:replace_with_strong_db_password@postgres:5432/ems_database?schema=public

# ------------------------------------------------------------------------------
# 4. CACHE & QUEUES (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. FRONTEND WEB APPLICATION (Next.js 14)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Samahat Taibah Educational Management System"
NEXT_PUBLIC_API_URL=https://ems.yourdomain.com/api/v1
NEXT_PUBLIC_AI_SERVICE_URL=https://ems.yourdomain.com/ai
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 6. AI MICROSERVICE (FastAPI / Gemini)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_ENV=production
AI_LOG_LEVEL=info
MAIN_API_INTERNAL_URL=http://api:4000/api/v1
AI_SERVICE_URL=http://ai-service:8000

# Google Gemini API
GEMINI_API_KEY=replace_with_production_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT=30
GEMINI_MAX_RETRIES=3
AI_MOCK_FALLBACK=false
