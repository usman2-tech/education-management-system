{
  "name": "education-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade Educational Management System (EMS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "body-parser": "^1.20.8",
    "js-yaml": "^4.3.2",
    "lodash": "^4.18.1",
    "postcss": "^8.5.31",
    "qs": "^6.16.1",
    "multer": "^2.4.0",
    "file-type": "^21.3.4"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspace=packages/contracts && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:packages": "npm run build --workspace=packages/contracts",
    "prisma:deploy": "npm run prisma:deploy --workspace=apps/api",
    "prisma:status": "npm run prisma:status --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "education-management-system",
    "school-erp",
    "nextjs",
    "nestjs",
    "fastapi",
    "prisma"
  ],
  "author": "EMS Architecture Team",
  "license": "UNLICENSED"
}
