{
  "name": "education-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade Educational Management System (EMS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspace=packages/contracts && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:packages": "npm run build --workspace=packages/contracts",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "education-management-system",
    "school-erp",
    "nextjs",
    "nestjs",
    "fastapi",
    "prisma"
  ],
  "author": "EMS Architecture Team",
  "license": "UNLICENSED"
}
